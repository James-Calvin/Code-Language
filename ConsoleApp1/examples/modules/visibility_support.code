package examples.modules.visibility;

public function<integer> publicAdd(integer value) {
  return value + 10;
}

package function<integer> packageAdd(integer value) {
  return value + 20;
}

private function<integer> privateAdd(integer value) {
  return value + 30;
}

public function<integer> readPrivate(integer value) {
  return privateAdd(value);
}
