whole window = windowCreate("demo", 800, 600);
print("window handle > 0: {window > 0}");
print("should close: {windowShouldClose(window)}");
print("space down: {windowInputKeyDown(window, 32)}");

gfxClear(window, 0, 0, 0, 1);
gfxDrawRectangle(window, 10, 10, 100, 50, 1, 0, 0, 1);
windowPresent(window);

print("engine stubs done");
