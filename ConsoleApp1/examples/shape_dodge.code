enum ObstacleKind {
  Rectangle;
  Circle;
  Diamond;
}

object GameState {
  integer score;
  integer lives;
  integer frameCount;
  boolean gameOver;

  constructor() {
    score = 0;
    lives = 3;
    frameCount = 0;
    gameOver = false;
  }

  function reset() {
    score = 0;
    lives = 3;
    frameCount = 0;
    gameOver = false;
  }
}

object BackgroundLayer {
  constructor() {
  }

  implement WorldDrawable.draw() {
    Draw.clearScreen(Colors.rgb(8, 11, 24));
    Draw.rectangle(Viewport.safeLeft(), Viewport.safeTop(), Viewport.safeWidth(), Viewport.safeHeight(), Colors.rgba(1. / 12, 1. / 8, 3. / 16, 1));
    Draw.rectangleOutline(Viewport.safeLeft(), Viewport.safeTop(), Viewport.safeWidth(), Viewport.safeHeight(), 2, Colors.rgba(3. / 4, 3. / 4, 1, 1. / 3));
    drawLaneGuides();
  }

  function drawLaneGuides() {
    real laneWidth = Viewport.safeWidth() / 5;
    integer lane = 1;
    while lane < 5 then {
      real x = Viewport.safeLeft() + laneWidth * lane;
      Draw.line(x, Viewport.safeTop(), x, Viewport.safeBottom(), Colors.rgba(1, 1, 1, 1. / 8));
      lane += 1;
    }

    Draw.line(
      Viewport.safeLeft(),
      Viewport.safeBottom() - 48,
      Viewport.safeRight(),
      Viewport.safeBottom() - 48,
      Colors.rgba(1, 1, 1, 1. / 8));
  }
}

object Player {
  GameState gameState;
  real x;
  real y;
  real width;
  real height;
  real speed;

  constructor(GameState gameState) {
    this.gameState = gameState;
    width = 28;
    height = 20;
    speed = 4;
    x = Viewport.safeLeft() + Viewport.safeWidth() / 2 - width / 2;
    y = Viewport.safeBottom() - height - 18;
  }

  function reset() {
    x = Viewport.safeLeft() + Viewport.safeWidth() / 2 - width / 2;
    y = Viewport.safeBottom() - height - 18;
  }

  implement Updatable.update() {
    if gameState.gameOver then return;

    if Input.keyIsDown(37) then x -= speed;
    if Input.keyIsDown(39) then x += speed;
    clampToSafeArea();
  }

  implement WorldDrawable.draw() {
    Draw.rectangle(x, y, width, height, Colors.rgb(48, 207, 255));
    Draw.rectangleOutline(x, y, width, height, 2, Colors.rgb(255, 255, 255));
    Draw.line(x + width / 2, y + 4, x + width / 2, y + height - 4, Colors.rgba(1, 1, 1, 2. / 3));
  }

  function clampToSafeArea() {
    real left = Viewport.safeLeft() + 10;
    real right = Viewport.safeRight() - width - 10;
    x = maximum(left, minimum(x, right));
  }
}

object Obstacle {
  real x;
  real y;
  real speed;
  real size;
  ObstacleKind kind;

  constructor(real x, real y, real speed, real size, ObstacleKind kind) {
    this.x = x;
    this.y = y;
    this.speed = speed;
    this.size = size;
    this.kind = kind;
  }
}

object ObstacleManager {
  GameState gameState;
  Player player;
  array<Obstacle> obstacles;
  array<integer> lanePattern;
  integer nextLaneIndex;
  integer nextKind;
  integer spawnInterval;

  constructor(GameState gameState, Player player) {
    this.gameState = gameState;
    this.player = player;
    obstacles = new array<Obstacle>(0);
    lanePattern = {0, 2, 4, 1, 3, 2, 0, 4, 1, 3};
    nextLaneIndex = 0;
    nextKind = 0;
    spawnInterval = 36;
  }

  function reset() {
    obstacles = new array<Obstacle>(0);
    nextLaneIndex = 0;
    nextKind = 0;
  }

  implement Updatable.update() {
    if gameState.gameOver then {
      if Input.keyIsDown(32) then {
        gameState.reset();
        player.reset();
        reset();
      }
      return;
    }

    gameState.frameCount += 1;
    if gameState.frameCount % spawnInterval == 0 then spawnObstacle();

    integer index = 0;
    while index < obstacles.length then {
      Obstacle obstacle = obstacles[index];
      obstacle.y += obstacle.speed;

      if overlapsPlayer(obstacle) then {
        obstacles.removeAt(index);
        gameState.lives -= 1;
        if gameState.lives <= 0 then {
          gameState.gameOver = true;
          return;
        }
      }
      else if obstacle.y > Viewport.safeBottom() + obstacle.size then {
        obstacles.removeAt(index);
        gameState.score += 1;
      }
      else {
        index += 1;
      }
    }
  }

  implement WorldDrawable.draw() {
    integer index = 0;
    while index < obstacles.length then {
      drawObstacle(obstacles[index]);
      index += 1;
    }
  }

  function spawnObstacle() {
    integer lane = lanePattern[nextLaneIndex];
    nextLaneIndex += 1;
    if nextLaneIndex >= lanePattern.length then nextLaneIndex = 0;

    integer kindIndex = nextKind;
    nextKind += 1;
    if nextKind >= 3 then nextKind = 0;

    ObstacleKind kind = kindFromIndex(kindIndex);
    real size = 20 + kindIndex * 6;
    real laneWidth = Viewport.safeWidth() / 5;
    real x = Viewport.safeLeft() + laneWidth * lane + (laneWidth - size) / 2;
    real y = Viewport.safeTop() - size - 8;
    real speed = 2 + kindIndex;
    obstacles.append(new Obstacle(x, y, speed, size, kind));
  }

  function<ObstacleKind> kindFromIndex(integer kindIndex) {
    if kindIndex == 0 then return ObstacleKind.Rectangle;
    if kindIndex == 1 then return ObstacleKind.Circle;
    return ObstacleKind.Diamond;
  }

  function<boolean> overlapsPlayer(Obstacle obstacle) {
    return
      obstacle.x < player.x + player.width and
      obstacle.x + obstacle.size > player.x and
      obstacle.y < player.y + player.height and
      obstacle.y + obstacle.size > player.y;
  }

  function drawObstacle(Obstacle obstacle) {
    Color fill = fillColor(obstacle);
    Color outline = outlineColor(obstacle);

    if obstacle.kind == ObstacleKind.Rectangle then {
      Draw.rectangle(obstacle.x, obstacle.y, obstacle.size, obstacle.size, fill);
      Draw.rectangleOutline(obstacle.x, obstacle.y, obstacle.size, obstacle.size, 2, outline);
      return;
    }

    if obstacle.kind == ObstacleKind.Circle then {
      Draw.circle(obstacle.x + obstacle.size / 2, obstacle.y + obstacle.size / 2, obstacle.size / 2, fill);
      Draw.circleOutline(obstacle.x + obstacle.size / 2, obstacle.y + obstacle.size / 2, obstacle.size / 2, 2, outline);
      return;
    }

    real half = obstacle.size / 2;
    array<real> points = new array<real>(8);
    points[0] = obstacle.x + half;
    points[1] = obstacle.y;
    points[2] = obstacle.x + obstacle.size;
    points[3] = obstacle.y + half;
    points[4] = obstacle.x + half;
    points[5] = obstacle.y + obstacle.size;
    points[6] = obstacle.x;
    points[7] = obstacle.y + half;
    Draw.polygon(points, fill);
    Draw.polygonOutline(points, 2, outline);
  }

  function<Color> fillColor(Obstacle obstacle) {
    if obstacle.kind == ObstacleKind.Rectangle then return Colors.rgb(255, 112, 112);
    if obstacle.kind == ObstacleKind.Circle then return Colors.rgb(255, 207, 64);
    return Colors.rgb(64, 207, 255);
  }

  function<Color> outlineColor(Obstacle obstacle) {
    if obstacle.kind == ObstacleKind.Rectangle then return Colors.rgb(255, 223, 223);
    if obstacle.kind == ObstacleKind.Circle then return Colors.rgb(255, 247, 191);
    return Colors.rgb(223, 255, 255);
  }
}

object HeadsUpDisplay {
  GameState gameState;

  constructor(GameState gameState) {
    this.gameState = gameState;
  }

  implement HudDrawable.drawHud() {
    Draw.text("Shape Dodge", 16, 16, 22, "left", "top", Colors.rgb(255, 255, 255));
    Draw.text("Left/Right move", Viewport.hudWidth() - 16, 16, 15, "right", "top", Colors.rgb(255, 255, 255));
    Draw.text("Score: {gameState.score}", 16, 48, 16, "left", "top", Colors.rgb(255, 255, 255));
    Draw.text("Lives: {gameState.lives}", 16, 72, 16, "left", "top", Colors.rgb(255, 255, 255));

    if gameState.gameOver then {
      Draw.text("Game Over", Viewport.hudWidth() / 2, Viewport.hudHeight() / 2 - 18, 28, "center", "middle", Colors.rgb(255, 223, 223));
      Draw.text("Press Space to restart", Viewport.hudWidth() / 2, Viewport.hudHeight() / 2 + 12, 16, "center", "middle", Colors.rgb(255, 255, 255));
    }
  }
}

Scene scene = new Scene();
SceneLoop loop = new SceneLoop(scene);
GameState gameState = new GameState();
BackgroundLayer backgroundLayer = new BackgroundLayer();
Player player = new Player(gameState);
ObstacleManager obstacleManager = new ObstacleManager(gameState, player);
HeadsUpDisplay headsUpDisplay = new HeadsUpDisplay(gameState);

function start() {
  Runtime.setFixedUpdateRate(60);
  scene.addWorldDrawable(backgroundLayer, 0);
  scene.addUpdatable(player);
  scene.addUpdatable(obstacleManager);
  scene.addWorldDrawable(obstacleManager, 10);
  scene.addWorldDrawable(player, 20);
  scene.addHudDrawable(headsUpDisplay, 0);
  loop.start();
}

function update() {
  loop.update();
}

function draw() {
  loop.draw();
}

function drawHud() {
  loop.drawHud();
}
