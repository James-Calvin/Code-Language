// Runnable example: records are copy-by-value data types.

record Stats {
  integer strength;
  integer defense;

  constructor(integer strength, integer defense) {
    this.strength = strength;
    this.defense = defense;
  }
}

function<Stats> raised(Stats base_stats) {
  base_stats.strength += 2;
  return base_stats;
}

Stats player = new Stats(3, 4);
Stats player_copy = player;
player.strength = 9;

print(player.strength);
print(player_copy.strength);

Stats promoted = raised(player_copy);
print(player_copy.strength);
print(promoted.strength);
