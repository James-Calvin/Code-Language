// Sized numeric storage boundaries and explicit narrowing.

function<whole8> echoChannel(byte value) {
  return value;
}

object Pixel {
  byte red;
  byte green;
  byte blue;

  constructor(byte red, byte green, byte blue) {
    this.red = red;
    this.green = green;
    this.blue = blue;
  }

  function<whole16> total() {
    whole16 result = red;
    result += green;
    result += blue;
    return result;
  }
}

byte channel = 250;
channel += 5;
print(channel);

whole8 sameChannel = channel;
whole16 widerWhole = channel;
integer16 widerSigned = channel;
print(sameChannel);
print(widerWhole);
print(widerSigned);

integer8 smallSigned = -12;
integer16 widerSignedFromSmall = smallSigned;
integer32 signedMin = -2147483648;
integer32 signedMax = 2147483647;
whole32 wholeMax = 4294967295;
whole32 hexMax = 0xffffffff;
print(widerSignedFromSmall);
print(signedMin);
print(signedMax);
print(wholeMax);
print(hexMax);

whole16 castWide = 300 as whole16;
integer8 truncated = 3.8 as integer8;
real32 storedReal32 = 1.25 as real32;
real64 storedReal64 = storedReal32;
print(castWide);
print(truncated);
print(storedReal64);

array<whole8> channels = new array<whole8>(0);
channels.append(channel);
print(channels.length);
print(channels[0]);
print(echoChannel(channel));

Pixel pixel = new Pixel(10 as byte, 20 as byte, 30 as byte);
print(pixel.total());
