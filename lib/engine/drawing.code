package engine.drawing;

import { Color } from "engine/colors.code";

export function clearScreen(Color color) {
  clear(color.red, color.green, color.blue, color.alpha);
}

export function line(real x1, real y1, real x2, real y2, Color color) {
  drawLine(x1, y1, x2, y2, color.red, color.green, color.blue, color.alpha);
}

export function rectangle(real x, real y, real width, real height, Color color) {
  drawRectangle(x, y, width, height, color.red, color.green, color.blue, color.alpha);
}

export function rectangleOutline(real x, real y, real width, real height, real lineWidth, Color color) {
  drawRectangleOutline(x, y, width, height, lineWidth, color.red, color.green, color.blue, color.alpha);
}

export function circle(real x, real y, real radius, Color color) {
  drawCircle(x, y, radius, color.red, color.green, color.blue, color.alpha);
}

export function circleOutline(real x, real y, real radius, real lineWidth, Color color) {
  drawCircleOutline(x, y, radius, lineWidth, color.red, color.green, color.blue, color.alpha);
}

export function polygon(array<real> points, Color color) {
  drawPolygon(points, color.red, color.green, color.blue, color.alpha);
}

export function polygonOutline(array<real> points, real lineWidth, Color color) {
  drawPolygonOutline(points, lineWidth, color.red, color.green, color.blue, color.alpha);
}

export function text(string value, real x, real y, real size, string horizontalAlignment, string verticalAlignment, Color color) {
  drawText(value, x, y, size, horizontalAlignment, verticalAlignment, color.red, color.green, color.blue, color.alpha);
}

export function image(string source, real x, real y, real width, real height, real alpha) {
  drawImage(source, x, y, width, height, alpha);
}

export function sprite(
  string source,
  real sourceX,
  real sourceY,
  real sourceWidth,
  real sourceHeight,
  real x,
  real y,
  real width,
  real height,
  real alpha) {
  drawSprite(source, sourceX, sourceY, sourceWidth, sourceHeight, x, y, width, height, alpha);
}
