object BenchmarkState {
  integer profile;
  integer loadLevel;
  boolean paused;
  integer presentedFrames;
  boolean leftWasDown;
  boolean rightWasDown;
  boolean upWasDown;
  boolean downWasDown;
  boolean spaceWasDown;
  boolean resetWasDown;

  constructor() {
    profile = 0;
    loadLevel = 3;
    paused = false;
    presentedFrames = 0;
    leftWasDown = false;
    rightWasDown = false;
    upWasDown = false;
    downWasDown = false;
    spaceWasDown = false;
    resetWasDown = false;
  }

  function resetSamples() {
    presentedFrames = 0;
  }
}

object RollingMetrics {
  array<real> samples;
  integer nextIndex;
  integer count;
  real average;
  real minimumValue;
  real maximumValue;

  constructor(integer capacity) {
    samples = new array<real>(capacity);
    nextIndex = 0;
    count = 0;
    average = 0;
    minimumValue = 0;
    maximumValue = 0;
  }

  function reset() {
    nextIndex = 0;
    count = 0;
    average = 0;
    minimumValue = 0;
    maximumValue = 0;
  }

  function add(real value) {
    if value <= 0 then return;

    samples[nextIndex] = value;
    nextIndex = (nextIndex + 1) % samples.length;
    if count < samples.length then count += 1;
    recompute();
  }

  function recompute() {
    if count == 0 then {
      average = 0;
      minimumValue = 0;
      maximumValue = 0;
      return;
    }

    real total = 0;
    minimumValue = samples[0];
    maximumValue = samples[0];

    integer index = 0;
    while index < count then {
      real value = samples[index];
      total += value;
      if value < minimumValue then minimumValue = value;
      if value > maximumValue then maximumValue = value;
      index += 1;
    }

    average = total / count;
  }
}

object MovingEntity {
  real x;
  real y;
  real velocityX;
  real velocityY;
  real size;
  Color color;

  constructor(integer index) {
    size = 5 + index % 9;
    x = Viewport.safeLeft() + 8 + (index * 23) % 620;
    y = Viewport.safeTop() + 8 + (index * 31) % 340;
    velocityX = 1 + index % 5;
    velocityY = 1 + (index * 2) % 5;
    color = Colors.rgb((48 + (index * 19) % 160) as byte, (96 + (index * 23) % 128) as byte, (144 + (index * 29) % 96) as byte);
  }

  function update() {
    x += velocityX;
    y += velocityY;

    if x < Viewport.safeLeft() or x + size > Viewport.safeRight() then velocityX = 0 - velocityX;
    if y < Viewport.safeTop() or y + size > Viewport.safeBottom() then velocityY = 0 - velocityY;
  }

  function draw() {
    Draw.rectangle(x, y, size, size, color);
  }
}

object DispatchActor {
  BenchmarkState state;
  integer index;
  real x;
  real y;
  real velocity;
  Color color;

  constructor(BenchmarkState state, integer index) {
    this.state = state;
    this.index = index;
    x = Viewport.safeLeft() + 8 + (index * 17) % 620;
    y = Viewport.safeTop() + 8 + (index * 13) % 340;
    velocity = 1 + index % 4;
    color = Colors.rgb((64 + (index * 11) % 160) as byte, (80 + (index * 17) % 160) as byte, 255);
  }

  implement Updatable.update() {
    if index >= state.loadLevel * 40 then return;
    if state.paused then return;

    x += velocity;
    if x > Viewport.safeRight() then x = Viewport.safeLeft() - 6;
  }

  implement WorldDrawable.draw() {
    if index >= state.loadLevel * 40 then return;
    Draw.circle(x, y, 3 + index % 5, color);
  }
}

BenchmarkState state;
RollingMetrics frameWorkMetrics;
array<MovingEntity> entities;
array<DispatchActor> dispatchActors;
Scene dispatchScene;
SceneLoop dispatchLoop;

function start() {
  state = new BenchmarkState();
  frameWorkMetrics = new RollingMetrics(120);
  entities = new array<MovingEntity>(0);
  dispatchActors = new array<DispatchActor>(0);
  dispatchScene = new Scene();
  dispatchLoop = new SceneLoop(dispatchScene);

  integer index = 0;
  while index < 1000 then {
    entities.append(new MovingEntity(index));
    index += 1;
  }

  index = 0;
  while index < 400 then {
    DispatchActor actor = new DispatchActor(state, index);
    dispatchActors.append(actor);
    dispatchScene.addUpdatable(actor);
    dispatchScene.addWorldDrawable(actor, index % 8);
    index += 1;
  }

  dispatchLoop.start();
}

function update() {
  handleControls();
  if state.paused then return;

  if state.profile == 1 then updateEntities();
  if state.profile == 2 then dispatchLoop.update();
}

function draw() {
  Draw.clearScreen(Colors.rgb(5, 8, 14));
  Draw.rectangle(Viewport.safeLeft(), Viewport.safeTop(), Viewport.safeWidth(), Viewport.safeHeight(), Colors.rgb(10, 16, 28));
  Draw.rectangleOutline(Viewport.safeLeft(), Viewport.safeTop(), Viewport.safeWidth(), Viewport.safeHeight(), 2, Colors.rgba(1, 1, 1, 1. / 4));

  if state.profile == 0 then drawPrimitiveProfile();
  if state.profile == 1 then drawEntityProfile();
  if state.profile == 2 then dispatchLoop.draw();
}

function drawHud() {
  state.presentedFrames += 1;
  if state.presentedFrames > 30 then frameWorkMetrics.add(Diagnostics.lastFrameWorkMilliseconds());

  real x = 16;
  real y = 14;
  Color textColor = Colors.rgb(238, 247, 255);
  Color dimColor = Colors.rgb(155, 174, 199);
  Color accentColor = Colors.rgb(112, 207, 255);

  Draw.text("Code Performance Dashboard", x, y, 18, "left", "top", textColor);
  y += 24;
  Draw.text("Profile: {profileName()} | Load: {state.loadLevel} | Paused: {state.paused}", x, y, 14, "left", "top", accentColor);
  y += 20;
  Draw.text("Controls: Left/Right profile, Up/Down load, Space pause, R reset samples", x, y, 13, "left", "top", dimColor);
  y += 28;

  Draw.text("Workload draw calls: {estimatedDrawCalls()} | Update steps: {Diagnostics.lastUpdateSteps()} | Dropped: {Diagnostics.lastDroppedUpdateSteps()}", x, y, 13, "left", "top", textColor);
  y += 20;
  Draw.text("Frame interval ms: {Diagnostics.lastFrameIntervalMilliseconds()} | Estimated FPS: {Diagnostics.estimatedFramesPerSecond()}", x, y, 13, "left", "top", textColor);
  y += 20;
  Draw.text("Frame work ms: {Diagnostics.lastFrameWorkMilliseconds()} | avg {frameWorkMetrics.average} | min {frameWorkMetrics.minimumValue} | max {frameWorkMetrics.maximumValue}", x, y, 13, "left", "top", textColor);
  y += 20;
  Draw.text("Update ms: {Diagnostics.lastUpdateWorkMilliseconds()} | Draw ms: {Diagnostics.lastDrawWorkMilliseconds()} | HUD ms: {Diagnostics.lastDrawHudWorkMilliseconds()}", x, y, 13, "left", "top", textColor);

  if state.presentedFrames <= 30 then {
    Draw.text("Warming up samples...", Viewport.hudWidth() - 16, 16, 14, "right", "top", Colors.rgb(255, 223, 112));
  }
}

function handleControls() {
  boolean leftNow = Input.keyIsDown(37);
  boolean rightNow = Input.keyIsDown(39);
  boolean upNow = Input.keyIsDown(38);
  boolean downNow = Input.keyIsDown(40);
  boolean spaceNow = Input.keyIsDown(32);
  boolean resetNow = Input.keyIsDown(82);

  if leftNow and not state.leftWasDown then {
    state.profile -= 1;
    if state.profile < 0 then state.profile = 2;
    resetSamples();
  }

  if rightNow and not state.rightWasDown then {
    state.profile += 1;
    if state.profile > 2 then state.profile = 0;
    resetSamples();
  }

  if upNow and not state.upWasDown then {
    state.loadLevel += 1;
    if state.loadLevel > 10 then state.loadLevel = 10;
    resetSamples();
  }

  if downNow and not state.downWasDown then {
    state.loadLevel -= 1;
    if state.loadLevel < 1 then state.loadLevel = 1;
    resetSamples();
  }

  if spaceNow and not state.spaceWasDown then state.paused = not state.paused;
  if resetNow and not state.resetWasDown then resetSamples();

  state.leftWasDown = leftNow;
  state.rightWasDown = rightNow;
  state.upWasDown = upNow;
  state.downWasDown = downNow;
  state.spaceWasDown = spaceNow;
  state.resetWasDown = resetNow;
}

function resetSamples() {
  state.resetSamples();
  frameWorkMetrics.reset();
}

function<string> profileName() {
  if state.profile == 0 then return "Primitive rendering";
  if state.profile == 1 then return "Entity update and draw";
  return "Scene dispatch";
}

function<integer> primitiveCount() {
  return state.loadLevel * 80;
}

function<integer> entityCount() {
  return state.loadLevel * 90;
}

function<integer> activeDispatchCount() {
  return state.loadLevel * 40;
}

function<integer> estimatedDrawCalls() {
  if state.profile == 0 then return primitiveCount() * 2;
  if state.profile == 1 then return entityCount();
  return activeDispatchCount();
}

function updateEntities() {
  integer count = entityCount();
  integer index = 0;
  while index < count then {
    entities[index].update();
    index += 1;
  }
}

function drawEntityProfile() {
  integer count = entityCount();
  integer index = 0;
  while index < count then {
    entities[index].draw();
    index += 1;
  }
}

function drawPrimitiveProfile() {
  integer count = primitiveCount();
  integer index = 0;
  while index < count then {
    real x = Viewport.safeLeft() + 8 + (index * 19) % 624;
    real y = Viewport.safeTop() + 8 + (index * 29) % 344;
    Color color = Colors.rgb((64 + (index * 7) % 160) as byte, (96 + (index * 13) % 128) as byte, (128 + (index * 17) % 96) as byte);

    if index % 4 == 0 then {
      Draw.rectangle(x, y, 8 + index % 12, 6 + index % 10, color);
      Draw.line(x - 6, y - 6, x + 18, y + 18, Colors.rgba(1, 1, 1, 1. / 5));
    } else if index % 4 == 1 then {
      Draw.circle(x, y, 3 + index % 8, color);
      Draw.circleOutline(x, y, 5 + index % 10, 1, Colors.rgba(1, 1, 1, 1. / 4));
    } else if index % 4 == 2 then {
      array<real> points = {x, y - 7, x + 8, y, x, y + 7, x - 8, y};
      Draw.polygon(points, color);
      Draw.polygonOutline(points, 1, Colors.rgba(1, 1, 1, 1. / 4));
    } else {
      Draw.rectangleOutline(x, y, 12, 12, 1, color);
      if index % 24 == 3 then Draw.text("{index}", x, y, 10, "left", "top", color);
    }

    index += 1;
  }
}
