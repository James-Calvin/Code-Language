}

export function<real> safeLeft() {
  return cameraSafeLeft();
}

export function<real> safeTop() {
  return cameraSafeTop();
}

export function<real> safeWidth() {
  return cameraSafeWidth();
}

export function<real> safeHeight() {
  return cameraSafeHeight();
}

export function<real> safeRight() {
