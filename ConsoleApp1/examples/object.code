object Person {
  string name = "unnamed";
  integer age;

  constructor(integer value) {
    age = value;
  }

  function<integer> years() {
    return age;
  }
}

object Team {
  string label = "core";
  Person lead;

  constructor(Person captain) {
    lead = captain;
  }
}

Person ada = new Person(37);
Team team = new Team(ada);
print(team.label);
print(team.lead.name);
print(team.lead.years());
