package engine.colors;

export object Color {
  real red;
  real green;
  real blue;
  real alpha;

  constructor(real red, real green, real blue, real alpha) {
    this.red = red;
    this.green = green;
    this.blue = blue;
    this.alpha = alpha;
  }
}

export function<Color> rgb(byte red, byte green, byte blue) {
  return new Color((red as real) / 255., (green as real) / 255., (blue as real) / 255., 1);
}

export function<Color> rgba(real red, real green, real blue, real alpha) {
  return new Color(red, green, blue, alpha);
}
