package engine.input;

export function<boolean> key_is_down(integer keycode) {
  return key_down(keycode);
}

export function<real> pointer_world_x_position() {
  return pointer_world_x();
}

export function<real> pointer_world_y_position() {
  return pointer_world_y();
}

export function<real> pointer_screen_x_position() {
  return pointer_screen_x();
}

export function<real> pointer_screen_y_position() {
  return pointer_screen_y();
}

export function<boolean> pointer_is_down_now() {
  return pointer_is_down();
}

export function<boolean> pointer_was_pressed_now() {
  return pointer_was_pressed();
}

export function<boolean> pointer_was_released_now() {
  return pointer_was_released();
}
