// Demonstrate optional<T> as either T or none

optional<integer> maybeCount = none;
print(maybeCount == none);         // 1
print(none != maybeCount);         // 0

optional<integer> actual = 7;
if actual != none then {
  integer count = actual;          // direct unwrap where integer is required
  print(count + 1);                // 8
}

// Compatibility helpers still exist, but new code should prefer checks above.
print(actual.or(99));              // 7
