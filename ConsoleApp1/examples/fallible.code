// Runnable example: typed recoverable errors use fallible<Value, ErrorCode>.
// For rapid prototypes, fallible<Value> defaults the error code type to integer.
// Use panic for unrecoverable bugs; use fallible when the caller should choose a fallback.

enum ParseError {
  Empty;
  Invalid;
}

function<fallible<integer, ParseError>> parseCount(string text) {
  if text == "" then return error(ParseError.Empty, "count was empty");
  if text == "one" then return 1;
  if text == "two" then return 2;
  return error(ParseError.Invalid, "expected 'one' or 'two'");
}

integer first = parseCount("two") on error {
  yield 0;
};

integer second = parseCount("") on error {
  print(error.message);
  switch error.code then {
    case ParseError.Empty then yield 0;
    case ParseError.Invalid then yield -1;
    default then yield -1;
  }
};

integer third = parseCount("many") on error {
  print(error.message);
  switch error.code then {
    case ParseError.Empty then yield 0;
    case ParseError.Invalid then yield -1;
    default then yield -1;
  }
};

function<fallible<integer>> quickLoad(boolean ok) {
  if ok then return 7;
  return error("quick load failed");
}

integer quick = quickLoad(false) on error {
  print(error.code);
  print(error.message);
  yield 0;
};

print(first);
print(second);
print(third);
print(quick);
