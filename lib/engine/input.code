package engine.input;

export function<boolean> keyIsDown(integer keycode) {
  return inputKeyDown(keycode);
}

export function<real> pointerWorldX() {
  return inputPointerWorldX();
}

export function<real> pointerWorldY() {
  return inputPointerWorldY();
}

export function<real> pointerScreenX() {
  return inputPointerScreenX();
}

export function<real> pointerScreenY() {
  return inputPointerScreenY();
}

export function<boolean> pointerIsDown() {
  return inputPointerIsDown();
}

export function<boolean> pointerWasPressed() {
  return inputPointerWasPressed();
}

export function<boolean> pointerWasReleased() {
  return inputPointerWasReleased();
}
