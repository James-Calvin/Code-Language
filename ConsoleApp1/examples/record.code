// Runnable example: records are copy-by-value helper types.

interface StrengthReader {
  function<integer> read();
}

record Stats {
  integer strength;
  integer bonus = 1;

  constructor(integer strength) {
    this.strength = strength;
  }

  function<Stats> boosted(integer amount) {
    strength += amount;
    bonus += 1;
    return this;
  }

  implement StrengthReader.read() {
    return strength;
  }
}

function<StrengthReader> expose(Stats stats) {
  return stats;
}

Stats player = new Stats(3);
Stats playerCopy = player;
player.strength = 9;

print(player.strength);
print(playerCopy.strength);

Stats promoted = playerCopy.boosted(2);
print(playerCopy.strength);
print(promoted.strength);
print(promoted.bonus);

StrengthReader reader = expose(promoted);
print(reader.read());
