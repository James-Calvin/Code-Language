package engine.scene_core;

export interface Startable {
  function<void> start();
}

export interface Updatable {
  function<void> update();
}

export interface WorldDrawable {
  function<void> draw();
}

export interface HudDrawable {
  function<void> drawHud();
}

object WorldDrawEntry {
  WorldDrawable item;
  integer layer;
  integer order;

  constructor(WorldDrawable item, integer layer, integer order) {
    this.item = item;
    this.layer = layer;
    this.order = order;
  }
}

object HudDrawEntry {
  HudDrawable item;
  integer layer;
  integer order;

  constructor(HudDrawable item, integer layer, integer order) {
    this.item = item;
    this.layer = layer;
    this.order = order;
  }
}

export object Scene {
  array<Startable> activeStartables;
  array<Startable> pendingAddStartables;
  array<Startable> pendingRemoveStartables;

  array<Updatable> activeUpdatables;
  array<Updatable> pendingAddUpdatables;
  array<Updatable> pendingRemoveUpdatables;

  array<WorldDrawEntry> activeWorldDrawables;
  array<WorldDrawEntry> pendingAddWorldDrawables;
  array<WorldDrawable> pendingRemoveWorldDrawables;
  array<WorldDrawEntry> pendingWorldLayerChanges;

  array<HudDrawEntry> activeHudDrawables;
  array<HudDrawEntry> pendingAddHudDrawables;
  array<HudDrawable> pendingRemoveHudDrawables;
  array<HudDrawEntry> pendingHudLayerChanges;

  integer nextWorldOrder;
  integer nextHudOrder;

  constructor() {
    activeStartables = new array<Startable>(0);
    pendingAddStartables = new array<Startable>(0);
    pendingRemoveStartables = new array<Startable>(0);

    activeUpdatables = new array<Updatable>(0);
    pendingAddUpdatables = new array<Updatable>(0);
    pendingRemoveUpdatables = new array<Updatable>(0);

    activeWorldDrawables = new array<WorldDrawEntry>(0);
    pendingAddWorldDrawables = new array<WorldDrawEntry>(0);
    pendingRemoveWorldDrawables = new array<WorldDrawable>(0);
    pendingWorldLayerChanges = new array<WorldDrawEntry>(0);

    activeHudDrawables = new array<HudDrawEntry>(0);
    pendingAddHudDrawables = new array<HudDrawEntry>(0);
    pendingRemoveHudDrawables = new array<HudDrawable>(0);
    pendingHudLayerChanges = new array<HudDrawEntry>(0);

    nextWorldOrder = 0;
    nextHudOrder = 0;
  }

  function addStartable(Startable item) {
    if containsStartable(pendingAddStartables, item) then return;

    integer pendingRemoveIndex = findStartableIndex(pendingRemoveStartables, item);
    if pendingRemoveIndex >= 0 then {
      pendingRemoveStartables.removeAt(pendingRemoveIndex);
      return;
    }

    if containsStartable(activeStartables, item) then return;
    pendingAddStartables.append(item);
  }

  function removeStartable(Startable item) {
    integer pendingAddIndex = findStartableIndex(pendingAddStartables, item);
    if pendingAddIndex >= 0 then {
      pendingAddStartables.removeAt(pendingAddIndex);
      return;
    }

    if containsStartable(pendingRemoveStartables, item) then return;
    if not containsStartable(activeStartables, item) then return;
    pendingRemoveStartables.append(item);
  }

  function addUpdatable(Updatable item) {
    if containsUpdatable(pendingAddUpdatables, item) then return;

    integer pendingRemoveIndex = findUpdatableIndex(pendingRemoveUpdatables, item);
    if pendingRemoveIndex >= 0 then {
      pendingRemoveUpdatables.removeAt(pendingRemoveIndex);
      return;
    }

    if containsUpdatable(activeUpdatables, item) then return;
    pendingAddUpdatables.append(item);
  }

  function removeUpdatable(Updatable item) {
    integer pendingAddIndex = findUpdatableIndex(pendingAddUpdatables, item);
    if pendingAddIndex >= 0 then {
      pendingAddUpdatables.removeAt(pendingAddIndex);
      return;
    }

    if containsUpdatable(pendingRemoveUpdatables, item) then return;
    if not containsUpdatable(activeUpdatables, item) then return;
    pendingRemoveUpdatables.append(item);
  }

  function addWorldDrawable(WorldDrawable item, integer layer) {
    if findWorldDrawEntryIndex(pendingAddWorldDrawables, item) >= 0 then return;

    integer pendingRemoveIndex = findWorldDrawableIndex(pendingRemoveWorldDrawables, item);
    if pendingRemoveIndex >= 0 then {
      pendingRemoveWorldDrawables.removeAt(pendingRemoveIndex);
      return;
    }

    if findWorldDrawEntryIndex(activeWorldDrawables, item) >= 0 then return;
    pendingAddWorldDrawables.append(new WorldDrawEntry(item, layer, 0));
  }

  function removeWorldDrawable(WorldDrawable item) {
    integer pendingAddIndex = findWorldDrawEntryIndex(pendingAddWorldDrawables, item);
    if pendingAddIndex >= 0 then {
      pendingAddWorldDrawables.removeAt(pendingAddIndex);
      integer pendingLayerChangeIndex = findWorldDrawEntryIndex(pendingWorldLayerChanges, item);
      if pendingLayerChangeIndex >= 0 then pendingWorldLayerChanges.removeAt(pendingLayerChangeIndex);
      return;
    }

    if containsWorldDrawable(pendingRemoveWorldDrawables, item) then return;
    if findWorldDrawEntryIndex(activeWorldDrawables, item) < 0 then return;

    integer activeLayerChangeIndex = findWorldDrawEntryIndex(pendingWorldLayerChanges, item);
    if activeLayerChangeIndex >= 0 then pendingWorldLayerChanges.removeAt(activeLayerChangeIndex);
    pendingRemoveWorldDrawables.append(item);
  }

  function setWorldDrawLayer(WorldDrawable item, integer layer) {
    integer pendingAddIndex = findWorldDrawEntryIndex(pendingAddWorldDrawables, item);
    if pendingAddIndex >= 0 then {
      pendingAddWorldDrawables[pendingAddIndex].layer = layer;
      return;
    }

    if findWorldDrawEntryIndex(activeWorldDrawables, item) < 0 then return;

    integer pendingChangeIndex = findWorldDrawEntryIndex(pendingWorldLayerChanges, item);
    if pendingChangeIndex >= 0 then {
      pendingWorldLayerChanges[pendingChangeIndex].layer = layer;
      return;
    }

    pendingWorldLayerChanges.append(new WorldDrawEntry(item, layer, 0));
  }

  function addHudDrawable(HudDrawable item, integer layer) {
    if findHudDrawEntryIndex(pendingAddHudDrawables, item) >= 0 then return;

    integer pendingRemoveIndex = findHudDrawableIndex(pendingRemoveHudDrawables, item);
    if pendingRemoveIndex >= 0 then {
      pendingRemoveHudDrawables.removeAt(pendingRemoveIndex);
      return;
    }

    if findHudDrawEntryIndex(activeHudDrawables, item) >= 0 then return;
    pendingAddHudDrawables.append(new HudDrawEntry(item, layer, 0));
  }

  function removeHudDrawable(HudDrawable item) {
    integer pendingAddIndex = findHudDrawEntryIndex(pendingAddHudDrawables, item);
    if pendingAddIndex >= 0 then {
      pendingAddHudDrawables.removeAt(pendingAddIndex);
      integer pendingLayerChangeIndex = findHudDrawEntryIndex(pendingHudLayerChanges, item);
      if pendingLayerChangeIndex >= 0 then pendingHudLayerChanges.removeAt(pendingLayerChangeIndex);
      return;
    }

    if containsHudDrawable(pendingRemoveHudDrawables, item) then return;
    if findHudDrawEntryIndex(activeHudDrawables, item) < 0 then return;

    integer activeLayerChangeIndex = findHudDrawEntryIndex(pendingHudLayerChanges, item);
    if activeLayerChangeIndex >= 0 then pendingHudLayerChanges.removeAt(activeLayerChangeIndex);
    pendingRemoveHudDrawables.append(item);
  }

  function setHudDrawLayer(HudDrawable item, integer layer) {
    integer pendingAddIndex = findHudDrawEntryIndex(pendingAddHudDrawables, item);
    if pendingAddIndex >= 0 then {
      pendingAddHudDrawables[pendingAddIndex].layer = layer;
      return;
    }

    if findHudDrawEntryIndex(activeHudDrawables, item) < 0 then return;

    integer pendingChangeIndex = findHudDrawEntryIndex(pendingHudLayerChanges, item);
    if pendingChangeIndex >= 0 then {
      pendingHudLayerChanges[pendingChangeIndex].layer = layer;
      return;
    }

    pendingHudLayerChanges.append(new HudDrawEntry(item, layer, 0));
  }

  function applyPendingStartables() {
    array<Startable> removals = pendingRemoveStartables;
    array<Startable> additions = pendingAddStartables;
    pendingRemoveStartables = new array<Startable>(0);
    pendingAddStartables = new array<Startable>(0);

    integer i = 0;
    while i < removals.length then {
      integer activeIndex = findStartableIndex(activeStartables, removals[i]);
      if activeIndex >= 0 then activeStartables.removeAt(activeIndex);
      i += 1;
    }

    i = 0;
    while i < additions.length then {
      Startable item = additions[i];
      if findStartableIndex(activeStartables, item) < 0 then {
        activeStartables.append(item);
        item.start();
      }
      i += 1;
    }
  }

  function applyPendingUpdatables() {
    array<Updatable> removals = pendingRemoveUpdatables;
    array<Updatable> additions = pendingAddUpdatables;
    pendingRemoveUpdatables = new array<Updatable>(0);
    pendingAddUpdatables = new array<Updatable>(0);

    integer i = 0;
    while i < removals.length then {
      integer activeIndex = findUpdatableIndex(activeUpdatables, removals[i]);
      if activeIndex >= 0 then activeUpdatables.removeAt(activeIndex);
      i += 1;
    }

    i = 0;
    while i < additions.length then {
      Updatable item = additions[i];
      if findUpdatableIndex(activeUpdatables, item) < 0 then activeUpdatables.append(item);
      i += 1;
    }
  }

  function applyPendingWorldDrawables() {
    array<WorldDrawable> removals = pendingRemoveWorldDrawables;
    array<WorldDrawEntry> layerChanges = pendingWorldLayerChanges;
    array<WorldDrawEntry> additions = pendingAddWorldDrawables;
    pendingRemoveWorldDrawables = new array<WorldDrawable>(0);
    pendingWorldLayerChanges = new array<WorldDrawEntry>(0);
    pendingAddWorldDrawables = new array<WorldDrawEntry>(0);

    integer i = 0;
    while i < removals.length then {
      integer activeIndex = findWorldDrawEntryIndex(activeWorldDrawables, removals[i]);
      if activeIndex >= 0 then activeWorldDrawables.removeAt(activeIndex);
      i += 1;
    }

    i = 0;
    while i < layerChanges.length then {
      integer activeIndex = findWorldDrawEntryIndex(activeWorldDrawables, layerChanges[i].item);
      if activeIndex >= 0 then activeWorldDrawables[activeIndex].layer = layerChanges[i].layer;
      i += 1;
    }

    i = 0;
    while i < additions.length then {
      WorldDrawEntry entry = additions[i];
      if findWorldDrawEntryIndex(activeWorldDrawables, entry.item) < 0 then {
        activeWorldDrawables.append(new WorldDrawEntry(entry.item, entry.layer, nextWorldOrder));
        nextWorldOrder += 1;
      }
      i += 1;
    }

    sortWorldDrawables();
  }

  function applyPendingHudDrawables() {
    array<HudDrawable> removals = pendingRemoveHudDrawables;
    array<HudDrawEntry> layerChanges = pendingHudLayerChanges;
    array<HudDrawEntry> additions = pendingAddHudDrawables;
    pendingRemoveHudDrawables = new array<HudDrawable>(0);
    pendingHudLayerChanges = new array<HudDrawEntry>(0);
    pendingAddHudDrawables = new array<HudDrawEntry>(0);

    integer i = 0;
    while i < removals.length then {
      integer activeIndex = findHudDrawEntryIndex(activeHudDrawables, removals[i]);
      if activeIndex >= 0 then activeHudDrawables.removeAt(activeIndex);
      i += 1;
    }

    i = 0;
    while i < layerChanges.length then {
      integer activeIndex = findHudDrawEntryIndex(activeHudDrawables, layerChanges[i].item);
      if activeIndex >= 0 then activeHudDrawables[activeIndex].layer = layerChanges[i].layer;
      i += 1;
    }

    i = 0;
    while i < additions.length then {
      HudDrawEntry entry = additions[i];
      if findHudDrawEntryIndex(activeHudDrawables, entry.item) < 0 then {
        activeHudDrawables.append(new HudDrawEntry(entry.item, entry.layer, nextHudOrder));
        nextHudOrder += 1;
      }
      i += 1;
    }

    sortHudDrawables();
  }

  function updateAll() {
    integer i = 0;
    while i < activeUpdatables.length then {
      activeUpdatables[i].update();
      i += 1;
    }
  }

  function drawAll() {
    integer i = 0;
    while i < activeWorldDrawables.length then {
      activeWorldDrawables[i].item.draw();
      i += 1;
    }
  }

  function drawHudAll() {
    integer i = 0;
    while i < activeHudDrawables.length then {
      activeHudDrawables[i].item.drawHud();
      i += 1;
    }
  }

  function<integer> findStartableIndex(array<Startable> items, Startable item) {
    integer i = 0;
    while i < items.length then {
      if items[i] == item then return i;
      i += 1;
    }
    return -1;
  }

  function<boolean> containsStartable(array<Startable> items, Startable item) {
    return findStartableIndex(items, item) >= 0;
  }

  function<integer> findUpdatableIndex(array<Updatable> items, Updatable item) {
    integer i = 0;
    while i < items.length then {
      if items[i] == item then return i;
      i += 1;
    }
    return -1;
  }

  function<boolean> containsUpdatable(array<Updatable> items, Updatable item) {
    return findUpdatableIndex(items, item) >= 0;
  }

  function<integer> findWorldDrawableIndex(array<WorldDrawable> items, WorldDrawable item) {
    integer i = 0;
    while i < items.length then {
      if items[i] == item then return i;
      i += 1;
    }
    return -1;
  }

  function<boolean> containsWorldDrawable(array<WorldDrawable> items, WorldDrawable item) {
    return findWorldDrawableIndex(items, item) >= 0;
  }

  function<integer> findHudDrawableIndex(array<HudDrawable> items, HudDrawable item) {
    integer i = 0;
    while i < items.length then {
      if items[i] == item then return i;
      i += 1;
    }
    return -1;
  }

  function<boolean> containsHudDrawable(array<HudDrawable> items, HudDrawable item) {
    return findHudDrawableIndex(items, item) >= 0;
  }

  function<integer> findWorldDrawEntryIndex(array<WorldDrawEntry> items, WorldDrawable item) {
    integer i = 0;
    while i < items.length then {
      if items[i].item == item then return i;
      i += 1;
    }
    return -1;
  }

  function<integer> findHudDrawEntryIndex(array<HudDrawEntry> items, HudDrawable item) {
    integer i = 0;
    while i < items.length then {
      if items[i].item == item then return i;
      i += 1;
    }
    return -1;
  }

  function sortWorldDrawables() {
    integer i = 1;
    while i < activeWorldDrawables.length then {
      integer j = i;
      while j > 0 and shouldSwapWorldEntries(activeWorldDrawables[j - 1], activeWorldDrawables[j]) then {
        WorldDrawEntry left = activeWorldDrawables[j - 1];
        activeWorldDrawables[j - 1] = activeWorldDrawables[j];
        activeWorldDrawables[j] = left;
        j -= 1;
      }
      i += 1;
    }
  }

  function<boolean> shouldSwapWorldEntries(WorldDrawEntry left, WorldDrawEntry right) {
    if left.layer > right.layer then return true;
    if left.layer == right.layer and left.order > right.order then return true;
    return false;
  }

  function sortHudDrawables() {
    integer i = 1;
    while i < activeHudDrawables.length then {
      integer j = i;
      while j > 0 and shouldSwapHudEntries(activeHudDrawables[j - 1], activeHudDrawables[j]) then {
        HudDrawEntry left = activeHudDrawables[j - 1];
        activeHudDrawables[j - 1] = activeHudDrawables[j];
        activeHudDrawables[j] = left;
        j -= 1;
      }
      i += 1;
    }
  }

  function<boolean> shouldSwapHudEntries(HudDrawEntry left, HudDrawEntry right) {
    if left.layer > right.layer then return true;
    if left.layer == right.layer and left.order > right.order then return true;
    return false;
  }
}

export object SceneLoop {
  Scene scene;
  boolean hasStarted;

  constructor(Scene scene) {
    this.scene = scene;
    hasStarted = false;
  }

  function start() {
    if hasStarted then return;
    scene.applyPendingStartables();
    scene.applyPendingUpdatables();
    scene.applyPendingWorldDrawables();
    scene.applyPendingHudDrawables();
    hasStarted = true;
  }

  function update() {
    if not hasStarted then start();
    scene.applyPendingStartables();
    scene.applyPendingUpdatables();
    scene.applyPendingWorldDrawables();
    scene.applyPendingHudDrawables();
    scene.updateAll();
  }

  function draw() {
    if not hasStarted then start();
    scene.drawAll();
  }

  function drawHud() {
    if not hasStarted then start();
    scene.drawHudAll();
  }
}
