print("host abi basic");

integer ms = unixMilliseconds();
integer us = unixMicroseconds();
integer ns = monotonicNanoseconds();
integer ticks = monotonicTicks();
integer freq = monotonicTicksPerSecond();

print("unixMilliseconds > 0: {ms > 0}");
print("unixMicroseconds > 0: {us > 0}");
print("monotonicNanoseconds >= 0: {ns >= 0}");
print("monotonicTicks > 0: {ticks > 0}");
print("monotonicTicksPerSecond > 0: {freq > 0}");
