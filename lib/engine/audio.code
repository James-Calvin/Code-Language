package engine.audio;

export function<boolean> canPlaySound() {
  return audioCanPlaySound();
}

export function<integer> playSound(string source, real volume) {
  return audioPlaySound(source, volume);
}

export function<integer> playLoopingSound(string source, real volume) {
  return audioPlayLoopingSound(source, volume);
}

export function stopSound(integer handle) {
  audioStopSound(handle);
}

export function setSoundVolume(integer handle, real volume) {
  audioSetSoundVolume(handle, volume);
}

export function<boolean> soundIsPlaying(integer handle) {
  return audioSoundIsPlaying(handle);
}

export function stopAllSounds() {
  audioStopAllSounds();
}
