package engine.viewport;

export function<real> viewLeft() {
  return cameraViewLeft();
}

export function<real> viewTop() {
  return cameraViewTop();
}

export function<real> viewWidth() {
  return cameraViewWidth();
}

export function<real> viewHeight() {
  return cameraViewHeight();
}

export function<real> viewRight() {
  return cameraViewRight();
}

export function<real> viewBottom() {
