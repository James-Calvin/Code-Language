package engine.loop;

import { Scene } from "engine/scene.code";

export object SceneLoop {
  Scene scene;
  boolean has_started;

  constructor(Scene scene) {
    this.scene = scene;
    has_started = false;
  }

  function start() {
    if has_started then return;
    scene.apply_pending_startables();
    scene.apply_pending_updatables();
    scene.apply_pending_world_drawables();
    scene.apply_pending_hud_drawables();
    has_started = true;
  }

  function update() {
    if not has_started then start();
    scene.apply_pending_startables();
    scene.apply_pending_updatables();
    scene.apply_pending_world_drawables();
    scene.apply_pending_hud_drawables();
    scene.update_all();
  }

  function draw() {
    if not has_started then start();
    scene.draw_all();
  }

  function draw_hud() {
    if not has_started then start();
    scene.draw_hud_all();
  }
}
