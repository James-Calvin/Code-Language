real volume = 0.6;
integer loopHandle = 0;
integer lastEffectHandle = 0;
boolean previousSpaceDown = false;
boolean previousMDown = false;
boolean previousUpDown = false;
boolean previousDownDown = false;

function start() {
}

function update() {
  boolean spaceDown = Input.keyIsDown(32);
  boolean mDown = Input.keyIsDown(77);
  boolean upDown = Input.keyIsDown(38);
  boolean downDown = Input.keyIsDown(40);

  if spaceDown and not previousSpaceDown then {
    lastEffectHandle = Audio.playSound("assets/click.wav", volume);
  }

  if mDown and not previousMDown then {
    if loopHandle != 0 and Audio.soundIsPlaying(loopHandle) then {
      Audio.stopSound(loopHandle);
      loopHandle = 0;
    } else {
      loopHandle = Audio.playLoopingSound("assets/loop.wav", volume);
    }
  }

  if upDown and not previousUpDown then {
    volume += 0.1;
    if volume > 1 then volume = 1;
    if loopHandle != 0 then Audio.setSoundVolume(loopHandle, volume);
  }

  if downDown and not previousDownDown then {
    volume -= 0.1;
    if volume < 0 then volume = 0;
    if loopHandle != 0 then Audio.setSoundVolume(loopHandle, volume);
  }

  previousSpaceDown = spaceDown;
  previousMDown = mDown;
  previousUpDown = upDown;
  previousDownDown = downDown;
}

function draw() {
  Draw.clearScreen(Colors.rgb(8, 12, 22));

  real centerX = Viewport.safeLeft() + Viewport.safeWidth() / 2;
  real centerY = Viewport.safeTop() + Viewport.safeHeight() / 2;
  real pulse = 28 + volume * 36;

  Draw.circle(centerX, centerY, pulse, Colors.rgba(0.1, 0.55, 0.95, 0.55));
  Draw.circleOutline(centerX, centerY, pulse + 8, 2, Colors.rgba(1, 1, 1, 0.5));
  Draw.line(centerX - 96, centerY, centerX + 96, centerY, Colors.rgba(1, 1, 1, 0.35));
  Draw.line(centerX, centerY - 72, centerX, centerY + 72, Colors.rgba(1, 1, 1, 0.35));
}

function drawHud() {
  Color textColor = Colors.rgb(245, 247, 255);
  Color accentColor = Colors.rgb(104, 216, 255);
  Color dimColor = Colors.rgb(150, 160, 180);

  Draw.text("Audio Demo", 18, 18, 20, "left", "top", textColor);
  Draw.text("Space: sound effect | M: loop music | Up/Down: volume", 18, 48, 14, "left", "top", dimColor);
  Draw.text("Audio unlocked: {Audio.canPlaySound()}", 18, 82, 14, "left", "top", accentColor);
  Draw.text("Volume: {volume}", 18, 106, 14, "left", "top", textColor);
  Draw.text("Last effect handle: {lastEffectHandle}", 18, 130, 14, "left", "top", textColor);
  Draw.text("Loop handle: {loopHandle} | playing: {Audio.soundIsPlaying(loopHandle)}", 18, 154, 14, "left", "top", textColor);
  Draw.text("First key or pointer input unlocks browser audio.", Viewport.hudWidth() - 18, Viewport.hudHeight() - 24, 13, "right", "bottom", dimColor);
}
